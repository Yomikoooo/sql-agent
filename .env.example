# cp .env.example .env and fill in a real key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Optional. llm.py defaults to deepseek-chat, so a clean clone runs without
# this line. Set it to switch models -- a name containing a colon (such as
# qwen2.5:3b) routes to a local Ollama instead of the DeepSeek endpoint.
# DEEPSEEK_API_MODEL=deepseek-chat
